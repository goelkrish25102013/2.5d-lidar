<?xml version="1.0"?>
<robot name="lidar_rig">
  <link name="base_link"/>

  <link name="pan_link"/>
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>              <!-- pan rotates about world-up Z -->
    <limit lower="0" upper="3.14159" effort="10" velocity="1"/>
  </joint>

  <link name="lidar_link"/>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="pan_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>  <!-- 90° roll: makes the lidar's native XY scan plane vertical -->
  </joint>
</robot>